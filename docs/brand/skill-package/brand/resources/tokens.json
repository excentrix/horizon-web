{
  "$comment": "Machine-readable mirror of the 'first light' brand tokens. Source of truth = src/app/(frontend)/globals.css. HSL strings are the raw Tailwind triples; hex is the rendered colour.",
  "brand": {
    "cream":    { "hsl": "43 82% 89%", "hex": "#FAEDCD", "token": "--hz-cream" },
    "paper":    { "hsl": "42 71% 96%", "hex": "#FDF8EC", "token": "--hz-paper" },
    "charcoal": { "hsl": "0 0% 25%",   "hex": "#414141", "token": "--hz-charcoal" },
    "ink":      { "hsl": "0 0% 13%",   "hex": "#212121", "token": "--hz-ink" },
    "indigo":   { "hsl": "240 53% 57%","hex": "#5858CC", "token": "--hz-indigo" },
    "energy":   { "hsl": "20 85% 50%", "hex": "#EC5B13", "token": "--hz-energy" }
  },
  "semantic": {
    "light": {
      "background": "var(--hz-paper)",
      "foreground": "var(--hz-charcoal)",
      "primary": "var(--hz-indigo)",
      "secondary": "var(--hz-cream)",
      "accent": "var(--hz-energy)",
      "muted": "42 50% 91%",
      "muted-foreground": "0 0% 42%",
      "border": "38 25% 82%",
      "input": "38 25% 78%",
      "ring": "var(--hz-indigo)",
      "card": "0 0% 100%",
      "destructive": "0 72% 45%"
    },
    "dark": {
      "background": "0 0% 10%",
      "foreground": "43 60% 92%",
      "primary": "240 60% 68%",
      "secondary": "0 0% 16%",
      "accent": "20 85% 55%",
      "muted": "0 0% 18%",
      "muted-foreground": "43 15% 65%",
      "border": "0 0% 24%",
      "input": "0 0% 26%",
      "card": "0 0% 13%",
      "destructive": "0 62% 40%"
    }
  },
  "status": {
    "success": "hsl(var(--success))",
    "error":   "hsl(var(--error))",
    "warning": "hsl(var(--warning))"
  },
  "radius": "1rem",
  "fonts": {
    "display": "Bricolage Grotesque (--font-display)",
    "body": "Instrument Sans (--font-body)",
    "mono": "Geist Mono (--font-geist-mono)"
  }
}
